{
    "id": "com.adamdither.dithereffect",
    "name": "Dither Effect Pro",
    "version": "1.0.0",
    "main": "index.html",
    "host": {
        "app": "PS",
        "minVersion": "23.3.0",
        "data": {
            "apiVersion": 2
        }
    },
    "manifestVersion": 4,
    "entrypoints": [
        {
            "type": "panel",
            "id": "ditherPanel",
            "minimumSize": {"width": 230, "height": 400},
            "maximumSize": {"width": 2000, "height": 2000},
            "preferredDockedSize": {"width": 280, "height": 550},
            "preferredFloatingSize": {"width": 280, "height": 580},
            "label": {"default": "Dither Effect"}
        }
    ]
}
